digraph casos_de_uso {
  rankdir=LR;
  fontname="Helvetica";
  nodesep=0.4;
  ranksep=1.6;
  node [fontname="Helvetica", fontsize=12];
  edge [arrowhead=none, color="#334155"];

  gestor [shape=none, label="Gestor de\nProjetos", image="ator.png", labelloc=b, imagescale=false, width=1.3, height=1.7, fixedsize=true];
  membro [shape=none, label="Membro da\nEquipe", image="ator.png", labelloc=b, imagescale=false, width=1.3, height=1.7, fixedsize=true];

  subgraph cluster_sistema {
    label="Sistema TechFlow Tasks";
    labeljust=c;
    style="rounded";
    color="#334155";
    fontsize=14;
    node [shape=ellipse, style=filled, fillcolor="#dbeafe", color="#2563eb", width=2.6, height=0.7];

    {
      rank=same;
      uc_filtrar [label="Filtrar por prioridade", fillcolor="#fef3c7", color="#d97706"];
      uc_excluir [label="Excluir tarefa"];
      uc_mover [label="Mover tarefa de status"];
      uc_editar [label="Editar tarefa"];
      uc_criar [label="Criar tarefa"];
      uc_quadro [label="Visualizar quadro Kanban"];
    }
    uc_filtrar -> uc_excluir -> uc_mover -> uc_editar -> uc_criar -> uc_quadro [style=invis];

    uc_prioridade [label="Definir prioridade", fillcolor="#fef3c7", color="#d97706"];
  }

  gestor -> uc_criar;
  gestor -> uc_quadro;
  gestor -> uc_editar;
  gestor -> uc_mover;
  gestor -> uc_excluir;
  gestor -> uc_filtrar;
  membro -> uc_quadro;
  membro -> uc_editar;
  membro -> uc_mover;
  membro -> uc_filtrar;

  uc_criar -> uc_prioridade [dir=back, arrowtail=vee, style=dashed, label="«extend»", fontsize=10, fontname="Helvetica"];
}
